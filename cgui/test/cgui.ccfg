	SECTION_ADD Monochrome
//	SECTION_ADD Wip_Theme
//	SECTION_ADD Dev
//	SECTION_ADD Shadow
//	SECTION_ADD Round_Gauges

	render mode           forward
	render sync_vblank    TRUE
	render sync_bypass    TRUE
	render partial_redraw TRUE

	input window_move       1
	input window_resize     3
	input window_fullscreen 2

	font face "Terminus"
	font size 20

SECTION Monochrome

	// Params

	LET c2  #FFFFFF
	LET c1  #E44332
	LET pad 15
	LET lin 3
	LET out 4
	LET gap 12
	LET win 20

	// Groups

	LET beacons beacon_on beacon_crit_on
	LET buttons button_idle button_disabled button_focused button_pressed
	LET lined_cells stripes placeholder
	LET simple_cells \
		filler \
		placeholder \
		stripes \
		label \
		button_idle \
		button_focused \
		button_pressed \
		button_disabled \
		beacon_on \
		beacon_off \
		beacon_crit_on \
		beacon_crit_off \
		gauge \
		gauge_bar \
		gauge_cursor

	// General settings

	grid gap $ gap
	grid pad $ pad

	window border_size  * $ lin 2
	window back_color   $ c1
	window border_color $ c2
	window pad          $ win
	popup  pad          $ win

	window_focused  enable_style FALSE
	window_disabled enable_style FALSE
	window_locked   enable_style FALSE
	popup           enable_style FALSE
	
	// Cell group settings

	FOR_EACH simple_cells cell
		% cell border_size  $ lin
		% cell pad          - $ pad $ lin
		% cell back_color   $ c1
		% cell border_color $ c2
		% cell text_color   $ c2
		% cell outline_size 0
		% cell margin       0
	FOR_END

	FOR_EACH lined_cells cell
		% cell pad        0
		% cell line_color $ c2
	FOR_END

	FOR_EACH buttons cell
		% cell corner_type square square cut square
		% cell corner_size 10
	FOR_END

	FOR_EACH beacons cell
		% cell pad           - $ pad * $ lin 4
		% cell margin        $ lin
		% cell outline_size  $ lin
		% cell outline_color $ c2
		% cell border_size   * $ lin 3
		% cell border_color  $ c1
		% cell back_color    $ c2
		% cell text_color    $ c1
		% cell text_bold     TRUE
	FOR_END

	// Cell custom settings

	filler draw FALSE

	placeholder line_size $ lin
	stripes     line_size * $ lin 2
	stripes     line_gap  * $ lin 3

	button_idle border_size   0
	button_idle pad           $ pad
	button_idle back_color    $ c2
	button_idle text_color    $ c1
	button_idle text_bold     TRUE
	button_idle outline_size  + $ lin $ out
	button_idle outline_color $ c1
	button_idle outline_shape FALSE

	button_focused margin         ! $ lin
	button_focused outline_size   $ out
	button_focused outline_color  $ c2
	button_focused border_size    $ lin
	button_focused border_color   $ c1
	button_focused back_color     $ c2
	button_focused text_color     $ c1
	button_focused text_bold      TRUE
	button_focused outline_hitbox TRUE

	button_pressed pad             + $ pad $ lin
	button_pressed margin          ! $ lin
	button_pressed outline_size    $ out
	button_pressed outline_color   $ c2
	button_pressed back_color      $ c1
	button_pressed text_color      $ c2
	button_pressed outline_hitbox  TRUE
	button_pressed border_size     0

	button_disabled outline_size  + $ lin $ out
	button_disabled outline_color $ c1
	button_disabled outline_shape FALSE

	beacon_crit_off margin        $ lin
	beacon_crit_off border_size   * $ lin 2
	beacon_crit_off pad           - $ pad * $ lin 2
	beacon_crit_off outline_size  $ lin
	beacon_crit_off outline_color $ c1

	gauge        pad          * $ lin 3
	gauge_bar    pad          * $ lin -4
	gauge_bar    border_size  0
	gauge_bar    back_color   $ c2
	gauge_cursor pad          - $ pad / $ lin 2
	gauge_cursor min_size     0




SECTION Wip_Theme

	grid gap 10
	grid pad 18

	LET windows window window_focused window_disabled window_locked popup
	FOR_EACH windows win
		% win border_size 3
		% win back_color  #202020
		% win enabled     TRUE
	FOR_END
	popup           pad          13
	window          pad          19
	window          border_color #808080
	window_focused  border_color #CCCCCC
	window_disabled border_color #000000
	window_locked   border_color #AA0000
	popup           border_color #00FFFF

	LET simple_cells filler placeholder stripes label button_idle button_focused button_pressed button_disabled beacon_on beacon_off beacon_crit_on beacon_crit_off gauge gauge_bar gauge_cursor
	FOR_EACH simple_cells cell
		% cell border_size  3
		% cell pad          12
		% cell line_size    3
		% cell back_color   #404040
		% cell text_color   #FFFFFF
		% cell border_color #808080
		% cell line_color   #808080
	FOR_END

	stripes     line_gap 15
	stripes     pad 0
	placeholder pad 0

	button_idle     back_color #602000
	button_focused  back_color #A04000
	button_disabled back_color #301000
	button_pressed  back_color #FFFFFF
	button_pressed  text_color #000000
	button_disabled text_color #808080
	button_pressed  text_bold  TRUE
	button_focused  border_color #CCCCCC

	gauge        pad            3
	gauge_bar    pad            -3
	gauge_cursor pad            9
	gauge_bar    border_size    3
	gauge_bar    back_color    #003030
	gauge_bar    outline_color #808080
	gauge_cursor back_color    #004545
	gauge_cursor min_size       0

	LET bon  beacon_on  beacon_crit_on
	LET boff beacon_off beacon_crit_off

	FOR_EACH bon cell
		% cell pad           9
		% cell outline_size  3
		% cell margin        3
		% cell outline_color #808080
		% cell border_color  #401A16
		% cell back_color    #9B2E21
		% cell border_size   6
		% cell text_bold     TRUE
	FOR_END

	beacon_crit_on outline_color #9B2E21

	FOR_EACH boff cell
		% cell pad           9
		% cell outline_size  3
		% cell margin        3
		% cell outline_color #808080
		% cell border_color  #202020
		% cell back_color    #404040
		% cell border_size   6
	FOR_END




SECTION Dev

	// Configuration example

	LET windows window window_focused window_disabled window_locked

	test pad 12

	font pad_pattern       "_"
	font face              "Terminus"
	font size              32
	font spacing_horz      0
	font spacing_vert      2
	font x_offset          0
	font y_offset          0
	font width             7
	font ascent            14
	font descent           0
	font override_geometry FALSE
	font antialias         subpixel
	font subpixel          rgb

	grid pad 60
	grid gap 45

	input auto_lock         TRUE
	input sticky_pointer    FALSE
	input sticky_touch      FALSE
	input window_move       1
	input window_resize     3
	input window_fullscreen 2

	button M3 app:exit
	button M2 app:reconfig

	key 30 app:exit

	window pad             50
	window border_color    #505050
	window_focused enabled TRUE

	FOR_EACH windows
		(% windows) border_size 20
		(% windows) corner_type round
		(% windows) corner_size 90
		(% windows) back_color (RGB 20 20 20)
	FOR_END

	popup pad          35
	popup border_size  10
	popup corner_type  cut
	popup corner_size  50
	popup border_color #ff5050
	popup enabled      TRUE

	LET passives label gauge filler

	FOR_EACH passives cell
		% cell border_color  (RGB 200 140   0)
		% cell back_color    (RGB 0    50  50)
		% cell border_size   14
		% cell outline_size  14
		% cell outline_color #ffffff
		% cell text_color    #ffffff
		% cell pad           - 60 14
	FOR_END

	LET lined_cells stripes placeholder

	FOR_EACH lined_cells cell
		% cell border_color  (RGB 200 140   0)
		% cell back_color    (RGB 0    50  50)
		% cell line_color    (RGB 200 140   0)
		% cell outline_color #ffffff
		% cell corner_size   10
		% cell border_size   14
		% cell outline_size  14
		% cell pad           -1
		% cell line_width    14
		% cell line_gap      20
	FOR_END

	LET buttons button_idle button_focused button_disabled button_pressed

	FOR_EACH buttons cell
		% cell border_color  (RGB 0  50  50)
		% cell back_color    (RGB 0 150 150)
		% cell outline_color #ffffff
		% cell corner_size   24
		% cell corner_type   square square cut square
		% cell border_size   14
		% cell outline_size  14
	FOR_END

	button_focused back_color #ffffff

	button_disabled back_color      RGB 0 25 25
	button_disabled text_back_color #999999
	button_disabled text_back_draw  TRUE
 
	button_pressed border_color   #ffffff
	button_pressed back_color    (RGB 0 50 50 )
	button_pressed outline_color (RGB 20 20 20)
	button_pressed outline_size   16

	LET bon  beacon_on  beacon_crit_on
	LET boff beacon_off beacon_crit_off

	FOR_EACH boff
		% boff border_color  #001010
		% boff back_color   (RGB 0    50  50)
		% boff corner_size   10
		% boff border_size   14
		% boff outline_size  14
		% boff outline_color #ffffff
		% boff pad           - 60 14
		% boff text_color    #ffffff
		% boff text_bold     FALSE
	FOR_END

	FOR_EACH bon
		% bon border_color  #4D1809
		% bon back_color    #D04219
		% bon corner_size   10
		% bon border_size   14
		% bon outline_size  14
		% bon outline_color #ffffff
		% bon pad           - 60 14
		% bon text_color    #000000
		% bon text_bold     TRUE
	FOR_END

	beacon blink_on  500
	beacon blink_off 500

	gauge text_color   #000000
	gauge text_bold    TRUE
	gauge pad           0
	gauge margin        0
	gauge border_size  14
	gauge outline_size 14

	gauge_bar margin       0
	gauge_bar pad          0
	gauge_bar border_size 14
	gauge_bar back_color  #51401b

	gauge_cursor pad           18
	gauge_cursor margin        0
	gauge_cursor corner_smart  TRUE
	gauge_cursor back_color    #c88c00
	gauge_cursor border_color  #ffffff
	gauge_cursor border_size   14
	gauge_cursor min_size      0





SECTION Shadow

	grid gap                    60
	grid pad                    70
	window pad                  70
	window corner_size          110
	window back_color           #505050
	window border_color         #101010
	button_pressed outline_size 0
	render partial              FALSE
	shadows reactive            TRUE
	shadows max_light_distance  200
	shadows max_offset          20
	window_focused enabled      FALSE

	LET widget \
		filler \
		stripes \
		button_idle \
		button_focused \
		button_pressed \
		button_disabled \
		beacon_off \
		beacon_on \
		beacon_critical_on \
		beacon_critical_off \
		placeholder \
		label \
		gauge

	FOR_EACH widget
		% widget shadow_draw     TRUE
		% widget shadow_color    #202020
		% widget shadow_x_offset 10
		% widget shadow_y_offset 10
	FOR_END





SECTION Round_Gauges

	grid pad 60

	gauge corner_type  round
	gauge corner_size  75
	gauge corner_smart FALSE
	gauge text_color   #000000
	gauge text_bold    TRUE
	gauge pad          50
	gauge margin        0
	gauge border_size  10
	gauge outline_size 10

	gauge_bar margin       0
	gauge_bar pad        -50
	gauge_bar border_size 10
	gauge_bar back_color  #51401b
	gauge_bar max_size    33

	gauge_cursor pad          30
	gauge_cursor margin       0
	gauge_cursor corner_smart TRUE
	gauge_cursor back_color   #c88c00
	gauge_cursor border_color #ffffff
	gauge_cursor border_size  10
	gauge_cursor min_size     112

