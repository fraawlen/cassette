	SECTION_ADD Shadow
	SECTION_ADD Round_Gauges

	// Configuration example

	LET windows window window_focused window_disabled window_locked

	test padding 32

	global scale 1.0
	global alternative_present_mode TRUE

	font face               "Terminus"
	font size               32
	font horizontal_spacing 0
	font vertical_spacing   2
	font x_offset           0
	font y_offset           0
	font width_override     7
	font ascent_override    14
	font descent_override   0
	font enable_overrides   FALSE
	font antialias_mode     subpixel
	font subpixel_mode      rgb

	grid padding 60
	grid spacing 45

	behavior async_present               FALSE
	behavior enable_cell_auto_lock       TRUE
	behavior enable_persistent_pointer   FALSE
	behavior enable_persistent_touch     FALSE
	behavior animation_framerate_divider 1
	behavior window_button_move          1
	behavior window_button_resize        3
	behavior window_button_fullscreen    2

	button M3 misc:exit
	button M2 misc:reconfig

	window padding 50
	window color_border #505050
	window enable_focused_substyle TRUE
	window allow_partial_redraws   TRUE

	FOR_EACH windows
		(% windows) border_thickness 20
		(% windows) corner_type radii
		(% windows) corner_size 90
		(% windows) color_background (RGB 20 20 20)
	FOR_END

	popup padding 35
	popup border_thickess 10
	popup corner_type chamfer
	popup corner_size 50
	popup color_border #ff5050

	LET passives label gauge filler

	FOR_EACH passives cell
		% cell color_border      (RGB 200 140   0)
		% cell color_background  (RGB 0    50  50)
		% cell border_thickness  14
		% cell outline_thickness 14
		% cell color_outline     #ffffff
		% cell text_color        #ffffff
		% cell padding           - 60 14
	FOR_END

	LET lined_cells stripes placeholder

	FOR_EACH lined_cells cell
		% cell color_border     (RGB 200 140   0)
		% cell color_background (RGB 0    50  50)
		% cell line_color       (RGB 200 140   0)
		% cell color_outline     #ffffff
		% cell corner_size       10
		% cell border_thickness  14
		% cell outline_thickness 14
		% cell padding           -1
		% cell line_width        14
		% cell line_spacing      20
	FOR_END

	LET buttons button_idle button_focused button_disabled button_pressed

	FOR_EACH buttons cell
		% cell color_border      (RGB 0  50  50)
		% cell color_background  (RGB 0 150 150)
		% cell color_outline     #ffffff
		% cell corner_size       24
		% cell corner_type       straight straight chamfer straight
		% cell border_thickness  14
		% cell outline_thickness 14
	FOR_END

	button_focused color_background #ffffff

	button_disabled color_background RGB 0 25 25
	button_disabled text_color_background #999999
	button_disabled text_draw_background  TRUE
 
	button_pressed color_border      #ffffff
	button_pressed color_background  (RGB 0 50 50 )
	button_pressed color_outline     (RGB 20 20 20)
	button_pressed outline_thickness 16

	LET bon  beacon_on  beacon_critical_on
	LET boff beacon_off beacon_critical_off

	FOR_EACH boff
		% boff color_border     #001010
		% boff color_background (RGB 0    50  50)
		% boff corner_size 10
		% boff border_thickness 14
		% boff outline_thickness 14
		% boff color_outline #ffffff
		% boff padding - 60 14
		% boff text_color #ffffff
		% boff text_bold FALSE
	FOR_END

	FOR_EACH bon
		% bon color_border     #4D1809
		% bon color_background #D04219
		% bon corner_size 10
		% bon border_thickness 14
		% bon outline_thickness 14
		% bon color_outline #ffffff
		% bon padding - 60 14
		% bon text_color #000000
		% bon text_bold TRUE
	FOR_END

	beacon blink_animation_speed_on  500
	beacon blink_animation_speed_off 500

	gauge       text_color       #000000
	gauge       text_bold        TRUE
	gauge       padding          10
	gauge       margin           0
	gauge       border_thickness 10
	gauge       outline_thickness 10
	gauge_bar   margin           0
	gauge_bar   padding          10
	gauge_bar   border_thickness 10
	gauge_bar   color_background #51401b
	gauge_label padding          10
	gauge_label margin           0
	gauge_label smart_corners    TRUE
	gauge_label color_background #c88c00
	gauge_label color_border     #ffffff
	gauge_label border_thickness 10
	gauge_label min_length       0

SECTION Shadow

	grid spacing 60
	window padding 70
	window corner_size 80
	window color_background #505050
	window enable_focused_substyle FALSE
	window color_border #101010
	button_pressed outline_thickness 0
	window allow_partial_redraws FALSE

	behavior enable_reactive_shadows TRUE
	behavior shadows_max_light_distance 200
	behavior shadows_max_offset 20

	LET widget \
		filler \
		stripes \
		button_idle \
		button_focused \
		button_pressed \
		button_disabled \
		beacon_off \
		beacon_on \
		beacon_critical_on \
		beacon_critical_off \
		placeholder \
		label \
		gauge \

	FOR_EACH widget
		% widget draw_shadow = TRUE
		% widget color_shadow #202020
		% widget shadow_x_offset 10
		% widget shadow_y_offset 10
	FOR_END

SECTION Round_Gauges

	gauge       corner_type      radii
	gauge       corner_size      75
	gauge       smart_corners    FALSE
	gauge       text_color       #000000
	gauge       text_bold        TRUE
	gauge       padding          50
	gauge       margin           0
	gauge       border_thickness 10
	gauge       outline_thickness 10
	gauge_bar   margin           0
	gauge_bar   padding          -50
	gauge_bar   border_thickness 10
	gauge_bar   color_background #51401b
	gauge_label padding          40
	gauge_label margin           0
	gauge_label smart_corners    TRUE
	gauge_label color_background #c88c00
	gauge_label color_border     #ffffff
	gauge_label border_thickness 10
	gauge_label min_length       112
	gauge_bar   max_thickness    33

