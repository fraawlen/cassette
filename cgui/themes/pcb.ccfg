// Fancy theme with many borders and outline, as well as huge window corners

	SECTION_ADD Pcb
//	SECTION_ADD Pcb_Shadows // Uncomment to enable reactive shadows

SECTION Pcb

	// Params

	LET lin 5
	LET pad 16

	// Groups

	LET windows window window_focused window_disabled window_locked popup
	LET buttons button_idle button_focused button_perssed button_disabled
	LET bon  beacon_on  beacon_crit_on
	LET boff beacon_off beacon_crit_off
	LET cells \
		filler \
		placeholder \
		stripes \
		label \
		button_idle \
		button_focused \
		button_pressed \
		button_disabled \
		beacon_on \
		beacon_off \
		beacon_crit_on \
		beacon_crit_off \
		gauge gauge_bar \
		gauge_cursor

	// Group settings

	FOR_EACH windows win
		% win border_size 10
		% win back_color  #131313
		% win corner_type round
		% win corner_size 40
	FOR_END

	FOR_EACH cells cell
		% cell margin          0
		% cell pad             - $ pad $ lin
		% cell border_size     $ lin
		% cell border_color    #C78B00
		% cell back_color      #003131
		% cell outline_size    $ lin
		% cell outline_color   #EEEEEE
		% cell text_color      #FFFFFF
		% cell text_bold       TRUE
		% cell line_gap        $ lin
		% cell line_size       $ lin
		% cell line_color      #C78B00
		% cell shadow_color    #202020
		% cell shadow_x_offset * $ lin 2
		% cell shadow_y_offset * $ lin 2
	FOR_END

	FOR_EACH buttons cell
		% cell corner_type square square cut square
		% cell corner_size * $ lin 2
	FOR_END

	FOR_EACH bon cell
		% cell border_color  #4C1708
		% cell back_color    #CF4118
		% cell text_color    #000000
	FOR_END

	FOR_EACH boff cell
		% cell border_color  #202020
		% cell back_color    #404040
	FOR_END

	// Individual settings

	grid gap * $ lin 3
	grid pad $ pad

	popup           pad          20
	window          pad          20
	window          border_color #4F4F4F
	window_focused  border_color #909090
	window_disabled border_color #303030
	window_locked   border_color #CF4118
	popup           border_color #303030

	stripes     pad -1
	placeholder pad -1

	button_idle border_color #003131
	button_idle back_color   #008B8B
	button_idle text_color   #000000

	button_focused border_color #003131
	button_focused back_color   #FFFFFF
	button_focused text_color   #000000

	button_pressed border_color  #FFFFFF
	button_pressed back_color    #001919
	button_pressed text_color    #FFFFFF
	button_pressed outline_color #131313
	button_pressed outline_size  + $ lin 1

	button_disabled border_color #003131
	button_disabled back_color   #001919
	button_disabled text_color   #808080

	gauge pad           $ lin
	gauge border_size   0
	gauge border_color  #003131
	gauge text_color    #000000
	gauge clip_contents TRUE

	gauge_bar pad          0
	gauge_bar margin       0
	gauge_bar border_size  0
	gauge_bar outline_size 0
	gauge_bar back_color   #C78B00
	gauge_bar corner_smart FALSE

	gauge_cursor pad          - $ pad $ lin
	gauge_cursor border_size  0
	gauge_cursor outline_size 0
	gauge_cursor corner_smart FALSE
	gauge_cursor draw         FALSE

// Optional, reactive shadows setup

SECTION Pcb_Shadows

	render  partial             FALSE
	shadows reactive            TRUE
	shadows max_light_distance  200
	shadows max_offset          * $ lin 3

	FOR_EACH windows win
		% win back_color  #505050
		% win corner_size 55
	FOR_END

	FOR_EACH cells cell
		% cell shadow_draw TRUE
	FOR_END
	
	grid           gap          * $ lin 6
	popup          pad          35
	window         pad          35
	window         border_color #303030
	button_pressed outline_size 0
